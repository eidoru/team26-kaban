// Paluwagan process rewrite. Spec: docs/PRODUCT_SPEC.md (rule IDs in comments).
// Money is integer centavos in BigInt columns (R-AMT-03); convert to number at the service boundary.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// §3
enum GroupState {
  LOBBY
  LAUNCHED
  ACTIVE
  COMPLETED
  COMPLETED_WITH_OUTSTANDING_DEBT
  CANCELLED
}

/// R-SET-04
enum Frequency {
  WEEKLY
  BI_WEEKLY
  TWICE_MONTHLY
  MONTHLY
  CUSTOM
}

/// R-SET-03
enum AmountMode {
  CONTRIBUTION
  POT
}

enum RoundStatus {
  UPCOMING
  OPEN
  CLOSED
}

/// R-SUB-01
enum SubmissionType {
  CONTRIBUTION
  DEBT_PAYMENT
}

/// R-SUB-03, R-SUB-04
enum ReviewStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
  /// A dispute left pending when its period closed (R-DEC-21).
  EXPIRED
}

/// R-PAY-05, R-DEC-07
enum PayoutStatus {
  AWAITING_HANDOVER
  HANDED_OVER
  CONFIRMED
}

/// §8: every change to a slot's debt is one row.
enum DebtEntryKind {
  SHORTFALL_COVERED
  INTEREST_CHARGED
  REPAYMENT
  PAYOUT_DEDUCTION
}

/// R-SWP-02, R-SWP-04
enum SwapStatus {
  AWAITING_TARGET
  AWAITING_ORGANIZER
  APPROVED
  DECLINED
  DENIED
  EXPIRED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  contact      String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens   RefreshToken[]
  notifications   Notification[]
  organizedGroups Group[]        @relation("Organizer")
  slots           Slot[]
  auditEntries    AuditEntry[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Group {
  id           String     @id @default(uuid())
  organizerId  String     @map("organizer_id")
  /// R-SET-01: unique among this organizer's non-cancelled paluwagans, checked by the service.
  name         String
  state        GroupState @default(LOBBY)
  slotCount    Int        @map("slot_count")
  amountMode   AmountMode @map("amount_mode")
  contribution BigInt
  pot          BigInt
  /// Pot mode: what the organizer typed, kept so slot changes recompute from it (R-LOB-10).
  enteredPot   BigInt?    @map("entered_pot")
  frequency    Frequency
  /// CUSTOM only (R-FRQ-05).
  intervalDays Int?       @map("interval_days")
  startDate    DateTime   @map("start_date") @db.Date
  /// Hundredths of a percent; 0 means no shortfall interest (R-SET-06).
  interestRate Int        @default(0) @map("interest_rate_bp")
  /// R-SET-07, R-DEC-38: what members agree to before joining or claiming. Copied at creation.
  terms        String
  launchedAt   DateTime?  @map("launched_at")
  activatedAt  DateTime?  @map("activated_at")
  completedAt  DateTime?  @map("completed_at")
  cancelledAt  DateTime?  @map("cancelled_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  organizer     User           @relation("Organizer", fields: [organizerId], references: [id])
  slots         Slot[]
  inviteLinks   InviteLink[]
  rounds        Round[]
  submissions   Submission[]
  disputes      Dispute[]
  refunds       Refund[]
  debtEntries   DebtEntry[]
  swaps         Swap[]
  auditEntries  AuditEntry[]
  notifications Notification[]

  @@index([organizerId])
  @@index([state])
  @@map("groups")
}

/// One position in the paluwagan, held by a user or a placeholder. History (submissions, debt,
/// payouts) belongs to the slot, so a claimer inherits all of it (R-CLM-06). Empty slots have no row.
model Slot {
  id                 String    @id @default(uuid())
  groupId            String    @map("group_id")
  /// Null while a placeholder.
  userId             String?   @map("user_id")
  isOrganizer        Boolean   @default(false) @map("is_organizer")
  placeholderName    String?   @map("placeholder_name")
  placeholderContact String?   @map("placeholder_contact")
  /// Payout position; null until the order is arranged (R-ORD-01).
  position           Int?
  /// When a user claimed this placeholder. Records before it are labeled inherited (R-CLM-06).
  claimedAt          DateTime? @map("claimed_at")
  /// Cached balance, the sum of this slot's DebtEntry rows.
  debtPrincipal      BigInt    @default(0) @map("debt_principal")
  debtInterest       BigInt    @default(0) @map("debt_interest")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  group           Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user            User?             @relation(fields: [userId], references: [id])
  claimLinks      ClaimLink[]
  roundsReceiving Round[]           @relation("RoundRecipient")
  periodResults   RoundSlotResult[]
  submissions     Submission[]
  disputes        Dispute[]
  refunds         Refund[]
  debtEntries     DebtEntry[]
  swapsRequested  Swap[]            @relation("SwapRequester")
  swapsTargeted   Swap[]            @relation("SwapTarget")
  reminders       ReminderSent[]

  /// R-INV-07: one slot per user per paluwagan.
  @@unique([groupId, userId])
  @@unique([groupId, position])
  @@map("slots")
}

/// R-LOB-01, R-INV-05: reusable while the group is in LOBBY. Permanent: never replaced or turned off.
model InviteLink {
  id        String    @id @default(uuid())
  groupId   String    @map("group_id")
  token     String    @unique @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("invite_links")
}

/// R-LOB-03, R-CLM-02: single-use. One permanent link per placeholder, until claimed.
model ClaimLink {
  id              String    @id @default(uuid())
  slotId          String    @map("slot_id")
  token           String    @unique @default(uuid())
  createdAt       DateTime  @default(now()) @map("created_at")
  revokedAt       DateTime? @map("revoked_at")
  claimedAt       DateTime? @map("claimed_at")
  claimedByUserId String?   @map("claimed_by_user_id")

  slot Slot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([slotId])
  @@map("claim_links")
}

/// Round k = Contribution Period k + Payout k (§2). Created at launch from the locked order.
model Round {
  id              String      @id @default(uuid())
  groupId         String      @map("group_id")
  number          Int
  periodStart     DateTime    @map("period_start") @db.Date
  payoutDate      DateTime    @map("payout_date") @db.Date
  /// Changes only through an approved swap (R-SWP-02).
  recipientSlotId String      @map("recipient_slot_id")
  status          RoundStatus @default(UPCOMING)
  closedAt        DateTime?   @map("closed_at")

  group       Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  recipient   Slot              @relation("RoundRecipient", fields: [recipientSlotId], references: [id])
  results     RoundSlotResult[]
  payout      Payout?
  submissions Submission[]
  debtEntries DebtEntry[]
  reminders   ReminderSent[]

  @@unique([groupId, number])
  @@index([status, payoutDate])
  @@map("rounds")
}

/// Each slot's outcome when a period closes (§7 steps 1–2): kept for summaries, exports and history.
model RoundSlotResult {
  id                 String @id @default(uuid())
  roundId            String @map("round_id")
  slotId             String @map("slot_id")
  due                BigInt
  /// Approved contribution at close; pending ones don't count (R-DEC-04).
  approved           BigInt
  shortfall          BigInt
  coveredByOrganizer BigInt @map("covered_by_organizer")

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
  slot  Slot  @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([roundId, slotId])
  @@map("round_slot_results")
}

/// §7 steps 3–5.
model Payout {
  id                String       @id @default(uuid())
  roundId           String       @unique @map("round_id")
  gross             BigInt
  ownShortfall      BigInt       @map("own_shortfall")
  interestDeducted  BigInt       @map("interest_deducted")
  principalDeducted BigInt       @map("principal_deducted")
  net               BigInt
  status            PayoutStatus @default(AWAITING_HANDOVER)
  handedOverAt      DateTime?    @map("handed_over_at")
  handedOverById    String?      @map("handed_over_by_id")
  proofPath         String?      @map("proof_path")
  confirmedAt       DateTime?    @map("confirmed_at")
  confirmedById     String?      @map("confirmed_by_id")
  /// R-DEC-07
  autoConfirmed     Boolean      @default(false) @map("auto_confirmed")

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@map("payouts")
}

/// §6.1. The organizer submits for placeholders and for themselves (R-SUB-02); every submission is
/// reviewed (R-SUB-03).
model Submission {
  id              String          @id @default(uuid())
  groupId         String          @map("group_id")
  slotId          String          @map("slot_id")
  /// The period, for CONTRIBUTION submissions.
  roundId         String?         @map("round_id")
  type            SubmissionType
  amount          BigInt
  /// What the submission counts as once approved. A contribution approved after its period closed
  /// applies as a debt repayment (R-DBT-06, R-DEC-04).
  appliedAs       SubmissionType? @map("applied_as")
  /// The amount in effect after any approved disputes (R-DSP-02); equals `amount` until then.
  effectiveAmount BigInt?         @map("effective_amount")
  status          ReviewStatus    @default(PENDING)
  proofPath       String?         @map("proof_path")
  note            String?
  submittedById   String          @map("submitted_by_id")
  submittedAt     DateTime        @default(now()) @map("submitted_at")
  reviewedById    String?         @map("reviewed_by_id")
  reviewedAt      DateTime?       @map("reviewed_at")
  denialReason    String?         @map("denial_reason")
  /// R-SUB-09
  selfApproved    Boolean         @default(false) @map("self_approved")
  /// R-DEC-33: one payment split across rounds, one submission per round; reviewed and withdrawn as one.
  batchId         String?         @map("batch_id")

  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  slot     Slot      @relation(fields: [slotId], references: [id], onDelete: Cascade)
  round    Round?    @relation(fields: [roundId], references: [id])
  disputes Dispute[]

  @@index([groupId, status, submittedAt])
  @@index([slotId, roundId])
  @@index([batchId])
  @@map("submissions")
}

/// §6.2: a request to change an approved contribution submission to `proposedAmount`.
model Dispute {
  id             String       @id @default(uuid())
  groupId        String       @map("group_id")
  submissionId   String       @map("submission_id")
  slotId         String       @map("slot_id")
  raisedById     String       @map("raised_by_id")
  /// The submission's amount when the dispute was raised; the correction is from this to proposedAmount.
  previousAmount BigInt       @map("previous_amount")
  proposedAmount BigInt       @map("proposed_amount")
  reason         String
  status         ReviewStatus @default(PENDING)
  createdAt      DateTime     @default(now()) @map("created_at")
  reviewedById   String?      @map("reviewed_by_id")
  reviewedAt     DateTime?    @map("reviewed_at")
  reviewNote     String?      @map("review_note")

  group      Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  slot       Slot       @relation(fields: [slotId], references: [id], onDelete: Cascade)
  refund     Refund?

  @@index([groupId, status])
  @@map("disputes")
}

/// R-DSP-03: an approved reduction, owed from the organizer to the member.
model Refund {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  slotId    String   @map("slot_id")
  disputeId String   @unique @map("dispute_id")
  amount    BigInt
  createdAt DateTime @default(now()) @map("created_at")

  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  slot    Slot    @relation(fields: [slotId], references: [id], onDelete: Cascade)
  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@map("refunds")
}

/// Append-only debt ledger (§8). Positive deltas add debt; repayments and deductions are negative.
model DebtEntry {
  id             String        @id @default(uuid())
  groupId        String        @map("group_id")
  slotId         String        @map("slot_id")
  kind           DebtEntryKind
  principalDelta BigInt        @map("principal_delta")
  interestDelta  BigInt        @map("interest_delta")
  roundId        String?       @map("round_id")
  submissionId   String?       @map("submission_id")
  createdAt      DateTime      @default(now()) @map("created_at")

  group Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  slot  Slot   @relation(fields: [slotId], references: [id], onDelete: Cascade)
  round Round? @relation(fields: [roundId], references: [id])

  @@index([slotId, createdAt])
  @@map("debt_entries")
}

/// §9
model Swap {
  id                String     @id @default(uuid())
  groupId           String     @map("group_id")
  requesterSlotId   String     @map("requester_slot_id")
  targetSlotId      String     @map("target_slot_id")
  status            SwapStatus @default(AWAITING_TARGET)
  createdAt         DateTime   @default(now()) @map("created_at")
  expiresAt         DateTime?  @map("expires_at")
  targetRespondedAt DateTime?  @map("target_responded_at")
  reviewedAt        DateTime?  @map("reviewed_at")
  reviewNote        String?    @map("review_note")

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  requester Slot  @relation("SwapRequester", fields: [requesterSlotId], references: [id], onDelete: Cascade)
  target    Slot  @relation("SwapTarget", fields: [targetSlotId], references: [id], onDelete: Cascade)

  @@index([groupId, status])
  @@map("swaps")
}

/// §13. Immutable: a database trigger rejects UPDATE and DELETE (R-AUD-02). Public to members (R-AUD-03).
model AuditEntry {
  id            String   @id @default(uuid())
  groupId       String   @map("group_id")
  /// Null for system actions (period close, auto-activation, auto-confirm).
  actorUserId   String?  @map("actor_user_id")
  action        String
  /// No foreign key: a slot can be removed in the lobby, but its history stays.
  targetSlotId  String?  @map("target_slot_id")
  /// The slot's name when this happened, so entries read correctly after it's gone.
  targetName    String?  @map("target_name")
  /// Amounts in centavos, keyed by meaning ({ amount, net, interest, ... }).
  amounts       Json?
  before        Json?
  after         Json?
  proofAttached Boolean? @map("proof_attached")
  selfApproved  Boolean  @default(false) @map("self_approved")
  createdAt     DateTime @default(now()) @map("created_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Restrict)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([groupId, createdAt])
  @@map("audit_entries")
}

/// §12. `kind` is a string so new events don't need a migration.
model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  groupId   String?   @map("group_id")
  kind      String
  title     String
  body      String
  link      String?
  data      Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// Reminders already sent, so the cron never sends one twice (§12).
model ReminderSent {
  id      String   @id @default(uuid())
  roundId String   @map("round_id")
  slotId  String   @map("slot_id")
  /// "BEFORE_PAYOUT", "PAYOUT_DAY", "MANUAL" (the organizer's send-reminder) or "RECEIPT" (confirm a payout).
  kind    String
  sentAt  DateTime @default(now()) @map("sent_at")

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
  slot  Slot  @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([roundId, slotId, kind])
  @@map("reminders_sent")
}
